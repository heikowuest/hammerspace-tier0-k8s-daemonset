---
apiVersion: v1
kind: ConfigMap
metadata:
  name: knfsd-exporter
  namespace: storage
data:
  start-nfs.sh: |
    #!/usr/bin/env sh
    set -eu

    : "${ALLOW_CIDR:=10.49.101.0/24}"
    : "${EXPORT_OPTS:=rw,nohide,sync,insecure,no_subtree_check,no_root_squash,sec=sys}"
    : "${NFSD_THREADS:=64}"
    : "${MOUNTD_PORT:=20048}"

    EXPORT_PATH="/local"

    echo "[knfsd] node=${NODE_NAME:-unknown} export=${EXPORT_PATH} allow=${ALLOW_CIDR} opts=${EXPORT_OPTS}"

    if [ ! -d /proc/fs/nfsd ]; then
      echo "[knfsd] ERROR: /proc/fs/nfsd missing"
      exit 1
    fi

    # Ensure nfsd pseudo-fs is mounted
    if [ ! -f /proc/fs/nfsd/threads ]; then
      mount -t nfsd nfsd /proc/fs/nfsd 2>/dev/null || true
    fi

    # Pin lockd ports (best-effort)
    sysctl -w fs.nfs.nlm_tcpport=32768 >/dev/null 2>&1 || true
    sysctl -w fs.nfs.nlm_udpport=32768 >/dev/null 2>&1 || true

    # NFSv3 helpers
    rpcbind -w
    rpc.statd --no-notify 2>/dev/null || true
    rpc.mountd -F -p "${MOUNTD_PORT}" --manage-gids &

    # Force NFSv3 only
    if [ -f /proc/fs/nfsd/versions ]; then
      echo "+3 -4 -4.1 -4.2" > /proc/fs/nfsd/versions 2>/dev/null || true
    fi

    # Start kernel nfsd threads
    if [ -f /proc/fs/nfsd/threads ]; then
      echo "${NFSD_THREADS}" > /proc/fs/nfsd/threads
    else
      rpc.nfsd "${NFSD_THREADS}" || true
    fi

    # Export /local
    cat > /etc/exports <<EOF
    ${EXPORT_PATH} ${ALLOW_CIDR}(${EXPORT_OPTS})
    EOF

    exportfs -rav
    exportfs -v || true

    echo "[knfsd] ready"
    tail -f /dev/null
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: hammerspace-attach
  namespace: storage
data:
  attach-hammerspace.sh: |
    #!/usr/bin/env bash
    set -euo pipefail

    : "${HSMGMT_IP:?set HSMGMT_IP}"
    : "${HS_USER:=admin}"
    : "${HS_PASS:?set HS_PASS}"
    : "${NODE_NAME:?set NODE_NAME}"
    : "${NODE_IP:?set NODE_IP}"
    : "${EXPORT_PATH:=/local}"
    : "${ALLOW_CIDR:=10.49.101.0/24}"

    : "${WAIT_SECONDS:=3}"
    : "${WAIT_TRIES:=40}"
    : "${SKIP_PERF_TEST:=true}"
    : "${FORCE:=true}"

    HS_BASE="https://${HSMGMT_IP}:443/mgmt/v1.2/rest"
    HDR=(-H "Content-Type: application/json" -H "Accept: application/json" -H "X-Admin: admin")
    AUTH=(-u "${HS_USER}:${HS_PASS}")
    CURL=(-sS -k "${AUTH[@]}" "${HDR[@]}")

    log() { echo "[attach-hs] $(date +%H:%M:%S) $*" >&2; }

    hs_get() { curl "${CURL[@]}" "${HS_BASE}$1"; }

    # prints "status|location|body"
    hs_post() {
      local path="$1"
      local json="$2"
      local tmp_h tmp_b status location
      tmp_h="$(mktemp)"; tmp_b="$(mktemp)"
      curl "${CURL[@]}" -D "$tmp_h" -o "$tmp_b" --data "$json" "${HS_BASE}${path}" || true
      status="$(head -n1 "$tmp_h" | awk '{print $2}')"
      location="$(awk -F': ' 'tolower($1)=="location"{print $2}' "$tmp_h" | tr -d '\r')"
      echo "${status}|${location}|$(cat "$tmp_b")"
      rm -f "$tmp_h" "$tmp_b"
    }

    wait_task() {
      local task_url="$1"
      local status="unknown"
      local i=0
      while [[ "$status" != "COMPLETED" ]]; do
        ((i++)) || true
        if (( i > WAIT_TRIES )); then
          log "ERROR: task did not complete in time: $task_url"
          return 1
        fi
        sleep "$WAIT_SECONDS"
        status="$(curl -sS -k "${AUTH[@]}" "$task_url" | jq -r '.status // "unknown"')"
        log "task status=$status url=$task_url"
        [[ "$status" == "FAILED" ]] && return 1
      done
    }

    add_node_if_needed() {
      local payload
      payload="$(jq -n --arg name "$NODE_NAME" --arg ip "$NODE_IP" \
        '{ _type:"NODE", nodeType:"OTHER", name:$name, mgmtIpAddress:{address:$ip} }')"

      local out status location body
      out="$(hs_post "/nodes" "$payload")"
      status="${out%%|*}"; out="${out#*|}"
      location="${out%%|*}"; body="${out#*|}"

      if [[ "$status" == "202" && -n "$location" ]]; then
        log "add node async: ${NODE_NAME} (${NODE_IP})"
        wait_task "$location"
        return 0
      fi
      if [[ "$status" =~ ^2 ]]; then
        log "add node ok: ${NODE_NAME} (${NODE_IP}) status=$status"
        return 0
      fi
      if echo "$body" | grep -qiE 'already exists|duplicate'; then
        log "node already exists, continuing"
        return 0
      fi
      log "add node failed status=$status body=${body:0:200}"
      return 1
    }

    wait_for_logical_volume() {
      local i=0
      while (( i < WAIT_TRIES )); do
        ((i++)) || true
        local node lv
        node="$(hs_get "/nodes/${NODE_NAME}")"
        lv="$(echo "$node" | jq -c --arg p "$EXPORT_PATH" '
          .platformServices[]?
          | select(._type=="LOGICAL_VOLUME")
          | select(.name==$p)
        ' | head -n1 || true)"

        if [[ -n "$lv" ]]; then
          echo "$node" > /tmp/hs_node.json
          echo "$lv"
          return 0
        fi

        log "waiting for LOGICAL_VOLUME ${EXPORT_PATH} on ${NODE_NAME} ..."
        sleep "$WAIT_SECONDS"
      done

      log "ERROR: LOGICAL_VOLUME ${EXPORT_PATH} did not appear for ${NODE_NAME}"
      log "DEBUG: visible LOGICAL_VOLUME names:"
      hs_get "/nodes/${NODE_NAME}" | jq -r '.platformServices[]? | select(._type=="LOGICAL_VOLUME") | .name' || true
      return 1
    }

    add_storage_volume() {
      local node_json="$1"
      local lv_json="$2"
      local volname="${NODE_NAME}::${EXPORT_PATH}"

      local payload
      payload="$(jq -n \
        --arg name "$volname" \
        --argjson node "$node_json" \
        --argjson lv "$lv_json" \
        '{ _type:"STORAGE_VOLUME", name:$name, logicalVolume:$lv, node:$node }')"

      local qs="?force=${FORCE}&skipPerfTest=${SKIP_PERF_TEST}"
      local out status location body
      out="$(hs_post "/storage-volumes${qs}" "$payload")"
      status="${out%%|*}"; out="${out#*|}"
      location="${out%%|*}"; body="${out#*|}"

      if [[ "$status" == "202" && -n "$location" ]]; then
        log "add storage-volume async: $volname"
        wait_task "$location"
        return 0
      fi
      if [[ "$status" =~ ^2 ]]; then
        log "add storage-volume ok: $volname status=$status"
        return 0
      fi
      if echo "$body" | grep -qiE 'already exists|duplicate'; then
        log "storage-volume already exists, continuing"
        return 0
      fi
      log "add storage-volume failed status=$status body=${body:0:200}"
      return 1
    }

    main() {
      log "registering ${NODE_IP}:${EXPORT_PATH} node=${NODE_NAME} allow=${ALLOW_CIDR}"
      add_node_if_needed
      lv_json="$(wait_for_logical_volume)"
      node_json="$(cat /tmp/hs_node.json)"
      add_storage_volume "$node_json" "$lv_json"
      log "DONE"
    }

    main
  reset-hammerspace-volume.sh: |
    #!/usr/bin/env bash
    set -euo pipefail

    : "${HSMGMT_IP:?set HSMGMT_IP}"
    : "${HS_USER:=admin}"
    : "${HS_PASS:?set HS_PASS}"
    : "${NODE_NAME:?set NODE_NAME}"
    : "${EXPORT_PATH:=/local}"

    : "${WAIT_SECONDS:=3}"
    : "${WAIT_TRIES:=60}"

    HS_BASE="https://${HSMGMT_IP}:443/mgmt/v1.2/rest"
    HDR=(-H "Content-Type: application/json" -H "Accept: application/json" -H "X-Admin: admin")
    AUTH=(-u "${HS_USER}:${HS_PASS}")
    CURL=(-sS -k "${AUTH[@]}" "${HDR[@]}")

    log() { echo "[reset] $(date +%H:%M:%S) $*" >&2; }

    hs_get() { curl "${CURL[@]}" "${HS_BASE}$1"; }

    # prints "status|location|body"
    hs_req() {
      local method="$1"
      local path="$2"
      local tmp_h tmp_b status location
      tmp_h="$(mktemp)"; tmp_b="$(mktemp)"
      curl "${CURL[@]}" -X "$method" -D "$tmp_h" -o "$tmp_b" "${HS_BASE}${path}" || true
      status="$(head -n1 "$tmp_h" | awk '{print $2}')"
      location="$(awk -F': ' 'tolower($1)=="location"{print $2}' "$tmp_h" | tr -d '\r')"
      echo "${status}|${location}|$(cat "$tmp_b")"
      rm -f "$tmp_h" "$tmp_b"
    }

    wait_task() {
      local task_url="$1"
      local status="unknown"
      local i=0
      while [[ "$status" != "COMPLETED" ]]; do
        ((i++)) || true
        if (( i > WAIT_TRIES )); then
          log "ERROR: task did not complete in time: $task_url"
          return 1
        fi
        sleep "$WAIT_SECONDS"
        status="$(curl -sS -k "${AUTH[@]}" "$task_url" | jq -r '.status // "unknown"')"
        log "task status=$status url=$task_url"
        [[ "$status" == "FAILED" ]] && return 1
      done
    }

    main() {
      local volname="${NODE_NAME}::${EXPORT_PATH}"
      log "reset requested for volume name: $volname"

      local uuid
      uuid="$(hs_get "/storage-volumes" \
        | jq -r --arg n "$volname" '.[] | select(.name==$n) | .uoid.uuid' \
        | head -n1 || true)"

      if [[ -z "$uuid" || "$uuid" == "null" ]]; then
        log "volume not found by name -> will just re-ensure"
        /scripts/attach-hammerspace.sh
        return 0
      fi

      log "deleting storage-volume uuid=$uuid"
      local out status location body
      out="$(hs_req "DELETE" "/storage-volumes/${uuid}")"
      status="${out%%|*}"; out="${out#*|}"
      location="${out%%|*}"; body="${out#*|}"

      if [[ "$status" == "202" && -n "$location" ]]; then
        log "delete async -> waiting task"
        wait_task "$location"
      elif [[ "$status" =~ ^2 ]]; then
        log "delete ok status=$status"
      elif [[ "$status" == "404" ]]; then
        log "delete returned 404 (already gone) -> continue"
      else
        log "WARNING: delete failed status=$status body=${body:0:200} -> continue to ensure"
      fi

      log "re-attaching after delete"
      /scripts/attach-hammerspace.sh
      log "reset done"
    }

    main
  run-attach-loop.sh: |
    #!/usr/bin/env sh
    set -eu

    apk add --no-cache bash curl jq ca-certificates util-linux >/dev/null

    SENTINEL="${SENTINEL_DIR:-/local/Hammerspace}"
    GRACE_SECONDS="${GRACE_SECONDS:-90}"
    COOLDOWN_SECONDS="${COOLDOWN_SECONDS:-600}"
    STATE_DIR="/state"
    LAST_RESET_FILE="${STATE_DIR}/last_reset_epoch"

    log() { echo "[attach] $*" >&2; }

    is_mounted() {
      findmnt -n --target /local >/dev/null 2>&1
    }

    mnt_source() {
      findmnt -n -o SOURCE --target /local 2>/dev/null || true
    }

    root_source() {
      findmnt -n -o SOURCE --target / 2>/dev/null || true
    }

    cooldown_ok() {
      now="$(date +%s)"
      last="$(cat "$LAST_RESET_FILE" 2>/dev/null || echo 0)"
      [ $((now - last)) -ge "$COOLDOWN_SECONDS" ]
    }

    mark_reset() {
      date +%s > "$LAST_RESET_FILE"
    }

    # Let knfsd come up first
    sleep 5

    # SAFETY: /local must be mounted and must not be on /
    if ! is_mounted; then
      log "/local is NOT mounted yet -> will not attach/reset"
      tail -f /dev/null
    fi

    src="$(mnt_source)"
    rtsrc="$(root_source)"

    if [ -z "$src" ] || [ -z "$rtsrc" ]; then
      log "cannot determine mount sources (local='$src' root='$rtsrc') -> refusing"
      tail -f /dev/null
    fi

    if [ "$src" = "$rtsrc" ]; then
      log "DANGER: /local appears to be on root filesystem (source=$src). Refusing."
      tail -f /dev/null
    fi

    # Optional: enforce expected device patterns (comment out if too strict)
    case "$src" in
      /dev/nvme*|/dev/md*|UUID=*|LABEL=*) : ;;
      *)
        log "WARNING: /local source=$src not in expected patterns; refusing for safety"
        tail -f /dev/null
        ;;
    esac

    log "/local mounted OK (source=$src)"

    # If sentinel exists, we are good. (Optionally ensure once)
    if [ -d "$SENTINEL" ]; then
      log "sentinel exists ($SENTINEL) -> ok"
      /scripts/attach-hammerspace.sh || true
      tail -f /dev/null
    fi

    # Sentinel missing -> ensure attach first
    log "sentinel missing -> ensure attach"
    if /scripts/attach-hammerspace.sh; then
      log "ensure succeeded, waiting ${GRACE_SECONDS}s for initialization"
    else
      log "ensure failed, still waiting ${GRACE_SECONDS}s"
    fi

    sleep "$GRACE_SECONDS"

    if [ -d "$SENTINEL" ]; then
      log "sentinel appeared after grace -> ok"
      tail -f /dev/null
    fi

    # Still missing -> reset (with cooldown)
    if cooldown_ok; then
      log "sentinel still missing after grace -> resetting volume (cooldown ok)"
      mark_reset
      /scripts/reset-hammerspace-volume.sh || true
    else
      log "sentinel still missing but cooldown active -> not resetting"
    fi

    tail -f /dev/null
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: knfsd-nfs3-hammerspace
  namespace: storage
spec:
  selector:
    matchLabels:
      app: knfsd-nfs3-hammerspace
  template:
    metadata:
      labels:
        app: knfsd-nfs3-hammerspace
    spec:
      # FAIL-SAFE: runs nowhere unless node has this label
      nodeSelector:
        hammerspace-tier0: "enabled"

      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet

      # Keep tolerations (so a labeled control-plane node can run it in single-node labs)
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"

      containers:
        - name: knfsd
          image: itsthenetwork/nfs-server-alpine:latest
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: ALLOW_CIDR
              value: "10.49.101.0/24"
            - name: EXPORT_OPTS
              value: "rw,nohide,sync,insecure,no_subtree_check,no_root_squash,sec=sys"
            - name: NFSD_THREADS
              value: "64"
            - name: MOUNTD_PORT
              value: "20048"
          command: ["/bin/sh", "/config/start-nfs.sh"]
          volumeMounts:
            - name: host-local
              mountPath: /local
            - name: nfs-config
              mountPath: /config
          ports:
            - name: nfs
              containerPort: 2049
              protocol: TCP
            - name: rpcbind-tcp
              containerPort: 111
              protocol: TCP
            - name: rpcbind-udp
              containerPort: 111
              protocol: UDP
            - name: mountd-tcp
              containerPort: 20048
              protocol: TCP
            - name: mountd-udp
              containerPort: 20048
              protocol: UDP

        - name: attach
          image: alpine:3.20
          imagePullPolicy: IfNotPresent
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            # hostNetwork=true => podIP equals node IP in your lab (good)
            - name: NODE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP

            # MGMT IP (fixed)
            - name: HSMGMT_IP
              value: "10.49.101.50"

            - name: HS_USER
              value: "admin"
            - name: HS_PASS
              valueFrom:
                secretKeyRef:
                  name: hammerspace-creds
                  key: password

            - name: EXPORT_PATH
              value: "/local"
            - name: ALLOW_CIDR
              value: "10.49.101.0/24"

            - name: GRACE_SECONDS
              value: "90"
            - name: COOLDOWN_SECONDS
              value: "600"

          command: ["/bin/sh", "/scripts/run-attach-loop.sh"]
          volumeMounts:
            - name: attach-scripts
              mountPath: /scripts
            # Needed for sentinel + mount safety checks
            - name: host-local
              mountPath: /local
              readOnly: true
            # Cooldown state (survives pod restarts)
            - name: tier0-state
              mountPath: /state

      volumes:
        - name: host-local
          hostPath:
            path: /local
            type: DirectoryOrCreate
        - name: nfs-config
          configMap:
            name: knfsd-exporter
            defaultMode: 0755
        - name: attach-scripts
          configMap:
            name: hammerspace-attach
            defaultMode: 0755
        - name: tier0-state
          hostPath:
            path: /var/lib/hammerspace-tier0-state
            type: DirectoryOrCreate

